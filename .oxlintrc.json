{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "unicorn"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-console": "warn",
    "eqeqeq": "error",
    "react/refs": "off",
    "react/static-components": "warn"
  },
  "ignorePatterns": ["styled-system", "dist", "storybook-static", "coverage"],
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
