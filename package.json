{
  "name": "react-ui",
  "version": "0.0.0",
  "description": "React UI components and utilities",
  "repository": "https://github.com/sibiraj-s/react-ui.git",
  "author": "sibiraj-s",
  "private": true,
  "bugs": "https://github.com/sibiraj-s/react-ui/issues",
  "homepage": "https://github.com/sibiraj-s/react-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "react-ui",
    "components",
    "hooks",
    "react-utilities"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "build": "tsdown",
    "dev": "storybook dev -p 4004 --no-open",
    "build:storybook": "storybook build",
    "lint": "oxlint",
    "prepare": "husky && panda codegen"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-aria/datepicker": "^3.17.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/progress": "^3.5.1",
    "@react-aria/switch": "^3.8.1",
    "@react-aria/textfield": "^3.19.1",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/datepicker": "^3.17.1",
    "@react-stately/toggle": "^3.10.1",
    "motion": "^13.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@pandacss/dev": "^2.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "commitlint-config-non-conventional": "^1.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "storybook-dark-mode": "^5.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
